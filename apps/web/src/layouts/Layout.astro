---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = "BrandEX Utilities - 100% Client-Side Free Developer & File Tools",
  description = "Suite of 214+ lightning-fast, zero-upload local browser utilities for PDF, image, developer, data, audio, video, and security operations with zero quality loss.",
  ogType = "website",
  ogImage = "/og-image.png",
  canonical
} = Astro.props;

// Determine clean site URL and canonical URL (strictly stripping query/tracking parameters)
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://brandex-utilities.vercel.app').replace(/\/$/, '');
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = canonical || `${siteUrl}${cleanPath === '/' ? '' : cleanPath}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Core Schema.org graph for Organization and WebSite
const organizationSchema = {
  "@type": "Organization",
  "@id": "https://brandex.co.in/#organization",
  "name": "BrandEX",
  "legalName": "BrandEX Digital Agency",
  "url": "https://brandex.co.in",
  "logo": `${siteUrl}/logo.svg`,
  "sameAs": [
    "https://brandex.co.in"
  ],
  "description": "BrandEX is a full-service digital agency providing bespoke software engineering, enterprise web applications, and digital business solutions.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Bangalore",
    "addressRegion": "Karnataka",
    "addressCountry": "IN"
  }
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "BrandEX Utilities",
  "url": siteUrl,
  "description": "214+ free, privacy-first online tools for developers, designers, and professionals. 100% browser-based with zero server uploads.",
  "publisher": {
    "@id": "https://brandex.co.in/#organization"
  }
};

const globalJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema
  ]
};
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon-white.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-white.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-white.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon-white.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary SEO Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Search Engine Indexing & AI Crawlers -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="application-name" content="BrandEX Utilities" />
    <meta name="apple-mobile-web-app-title" content="BrandEX Tools" />
    <meta name="theme-color" content="#4F46E5" />

    <!-- Open Graph / Facebook / LinkedIn / Discord -->
    <meta property="og:site_name" content="BrandEX Utilities" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BrandEX Utilities - Free Online Developer and File Tools" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="BrandEX Utilities - Free In-Browser Online Tools" />

    <!-- Web Performance: DNS Prefetch & Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Global Structured Data (Organization + WebSite) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(globalJsonLd)} />
  </head>
  <body class="min-h-full flex flex-col overflow-x-hidden max-w-full font-sans bg-white text-slate-900 selection:bg-[#EEF2FF] selection:text-[#4F46E5]">
    <slot />
  </body>
</html>
