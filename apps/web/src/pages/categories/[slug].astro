---
import Layout from '@/layouts/Layout.astro';
import CategoryDetailPage from '@/components/pages/CategoryDetailPage';
import { CATEGORIES } from '@/lib/categories';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { slug } = Astro.params;
const { category } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://brandex-utilities.vercel.app').replace(/\/$/, '');
const categoryUrl = `${siteUrl}/categories/${category.slug}`;

const pageTitle = `${category.name} Utilities — Free Online Tools | BrandEX`;
const pageDesc = `${category.description} Free online suite of ${category.featuredTools?.length || category.toolCount} tools. 100% private, client-side execution with zero file uploads.`;

const breadcrumbsSchema = {
  "@type": "BreadcrumbList",
  "@id": `${categoryUrl}/#breadcrumbs`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Categories",
      "item": `${siteUrl}/categories`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": category.name,
      "item": categoryUrl
    }
  ]
};

const collectionSchema = {
  "@type": "CollectionPage",
  "@id": `${categoryUrl}/#collection`,
  "name": `${category.name} Utilities`,
  "url": categoryUrl,
  "description": category.description,
  "isPartOf": {
    "@id": `${siteUrl}/#website`
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": `${category.name} Online Tools`,
    "numberOfItems": category.featuredTools?.length || 0,
    "itemListElement": (category.featuredTools || []).map((tool, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": tool.name,
      "url": `${siteUrl}/tools/${tool.id}`
    }))
  }
};

const categoryJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbsSchema,
    collectionSchema
  ]
};
---

<Layout title={pageTitle} description={pageDesc}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(categoryJsonLd)} />
  <CategoryDetailPage client:load slug={slug} />
</Layout>
