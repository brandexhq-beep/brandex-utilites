---
import Layout from '@/layouts/Layout.astro';
import ToolDetailPage from '@/components/pages/ToolDetailPage';
import { getAllTools, UtilityItem, CategoryData } from '@/lib/categories';

export function getStaticPaths() {
  const tools = getAllTools();
  // Filter out any standalone pages like qr-studio which has its own file
  return tools
    .filter(item => item.tool.id !== 'qr-studio')
    .map(item => ({
      params: { id: item.tool.id },
      props: { tool: item.tool, category: item.category }
    }));
}

interface Props {
  tool: UtilityItem;
  category: CategoryData;
}

const { tool, category } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://brandex-utilities.vercel.app').replace(/\/$/, '');
const toolUrl = `${siteUrl}/tools/${tool.id}`;
const categoryUrl = `${siteUrl}/categories/${category.slug}`;

const pageTitle = `${tool.name} — Free Online Tool | BrandEX Utilities`;
const pageDesc = `${tool.description} Free, fast, and 100% private. Process ${tool.inputFormats.join(', ')} directly in your browser with zero server uploads.`;

// 1. WebApplication Schema
const webApplicationSchema = {
  "@type": "WebApplication",
  "@id": `${toolUrl}/#app`,
  "name": tool.name,
  "url": toolUrl,
  "description": tool.description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "softwareVersion": "1.0.0",
  "author": {
    "@type": "Organization",
    "@id": "https://brandex.co.in/#organization",
    "name": "BrandEX",
    "url": "https://brandex.co.in"
  }
};

// 2. BreadcrumbList Schema
const breadcrumbsSchema = {
  "@type": "BreadcrumbList",
  "@id": `${toolUrl}/#breadcrumbs`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "All Categories",
      "item": `${siteUrl}/categories`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": category.name,
      "item": categoryUrl
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": tool.name,
      "item": toolUrl
    }
  ]
};

// 3. FAQPage Schema
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${toolUrl}/#faq`,
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is ${tool.name} completely free to use?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, ${tool.name} is 100% free with no hidden fees, subscriptions, or account requirements.`
      }
    },
    {
      "@type": "Question",
      "name": `Are files or data uploaded to any remote server when using ${tool.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Never. BrandEX Utilities operates on a client-side architecture. All processing executes locally within your browser using your device's CPU and memory.`
      }
    },
    {
      "@type": "Question",
      "name": `Does ${tool.name} work on mobile phones and tablets?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. All BrandEX tools are responsive and work smoothly across modern mobile browsers including Safari on iOS and Chrome on Android.`
      }
    },
    {
      "@type": "Question",
      "name": `What file formats are supported by ${tool.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${tool.name} accepts ${tool.inputFormats.join(', ')} and exports to ${tool.outputFormats.join(', ')}.`
      }
    }
  ]
};

// 4. HowTo Schema
const howToSchema = {
  "@type": "HowTo",
  "@id": `${toolUrl}/#howto`,
  "name": `How to use ${tool.name}`,
  "description": `Step-by-step instructions to execute ${tool.name} in your browser with zero data uploads.`,
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Provide Input",
      "text": `Select or drop your ${tool.inputFormats.join(', ')} files, or paste raw text content into the workspace.`
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Adjust Parameters",
      "text": "Configure tool settings, options, or formatting choices to match your desired output."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Execute and Download",
      "text": "Run the utility locally to instantly view, copy, or download the processed results."
    }
  ]
};

const toolJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    webApplicationSchema,
    breadcrumbsSchema,
    faqSchema,
    howToSchema
  ]
};
---

<Layout title={pageTitle} description={pageDesc}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(toolJsonLd)} />
  <ToolDetailPage client:load tool={tool} category={category} />
</Layout>
