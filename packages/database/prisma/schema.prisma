datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  jobs      Job[]
}

model Utility {
  id             String  @id
  name           String
  category       String
  processingMode String  // LOCAL, LOCAL_PREFERRED, SERVER
  enabled        Boolean @default(true)
  version        String
  jobs           Job[]
}

model Job {
  id          String    @id @default(cuid())
  userId      String?
  utilityId   String
  status      String    // QUEUED, VALIDATING, PROCESSING, FINALIZING, COMPLETED, FAILED, CANCELLED, EXPIRED
  progress    Int       @default(0)
  inputSize   BigInt?
  outputSize  BigInt?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?
  errorCode   String?

  user        User?     @relation(fields: [userId], references: [id])
  utility     Utility   @relation(fields: [utilityId], references: [id])
  files       File[]
  events      JobEvent[]
}

model File {
  id         String   @id @default(cuid())
  jobId      String
  kind       String   // input, working, output
  storageKey String   // e.g. inputs/job_123/file.pdf
  mimeType   String
  size       BigInt
  checksum   String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  job        Job      @relation(fields: [jobId], references: [id])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  eventType String
  progress  Int
  message   String?
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id])
}
